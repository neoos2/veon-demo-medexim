---
import { Image } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import logo from "../assets/img/medexim-logo.png";
import { nav, phones, email, hours, NOTE } from "../data/site";
---
<header class="site-header" data-header data-rec="R-U03,R-U04">
  <div class="site-header__bar container">
    <a class="logo" href="#top" aria-label="Мед Ексім — на початок сторінки">
      <Image src={logo} alt="Мед Ексім" width={188} height={96} loading="eager" class="logo__img" />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Розділи головної">
      <ul class="site-nav__list">
        {nav.map((item) => <li><a class="site-nav__link" href={item.href}>{item.label}</a></li>)}
      </ul>
      <div class="site-nav__extra">
        <ul class="site-nav__future">
          <li><FutureLink note={NOTE}>Про компанію</FutureLink></li>
          <li><FutureLink note={NOTE}>Акції</FutureLink></li>
          <li><FutureLink note={NOTE}>Новини</FutureLink></li>
        </ul>
        <div class="site-nav__contacts">
          <a class="site-nav__phone num" href={phones.main.href}>{phones.main.label}</a>
          <a class="site-nav__phone num" href={phones.service.href}>{phones.service.label}<span class="site-nav__role"> сервіс</span></a>
          <a class="ulink" href={`mailto:${email}`}>{email}</a>
          <p class="site-nav__hours">{hours}</p>
        </div>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="hdr-phone num" href={phones.main.href} aria-label={`Зателефонувати: ${phones.main.label}`}>
        <svg class="hdr-phone__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z" fill="currentColor"/></svg>
        <span class="hdr-phone__text">{phones.main.label}</span>
      </a>
      <span class="lang-switch">
        <span class="lang-switch__current" aria-current="true">UK</span>
        <FutureLink note={NOTE} class="lang-switch__ru" lang="ru" aria-label="Російська версія">RU</FutureLink>
      </span>
      <a class="btn btn--primary hdr-cta" href="#request"><span class="hdr-cta__long">Запит пропозиції</span><span class="hdr-cta__short" aria-hidden="true">Запит</span></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn hidden>
        <span class="menu-btn__bars" aria-hidden="true"></span>
        <span class="menu-btn__label">Меню</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-bg);
    border-bottom: var(--line) solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .site-header.is-scrolled { border-bottom-color: var(--color-border); }
  .site-header__bar { display: flex; align-items: center; gap: var(--space-3); min-height: var(--header-h); }
  .logo { display: inline-flex; flex: none; border-radius: var(--radius); }
  .logo__img { height: 36px; width: auto; }

  .site-nav { margin-inline: auto; }
  .site-nav__list { list-style: none; display: flex; gap: var(--space-3); }
  .site-nav__link {
    position: relative; display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-body); font-size: var(--fs-body); text-decoration: none; color: var(--color-text); white-space: nowrap;
  }
  .site-nav__link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__link:hover::after, .site-nav__link:focus-visible::after { transform: scaleX(1); }
  .site-nav__extra { display: none; }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-2); flex: none; }
  .hdr-phone {
    display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44px; min-width: 44px; justify-content: center;
    font-size: 1.125rem; font-weight: 600; text-decoration: none; color: var(--color-text);
  }
  .hdr-phone:hover .hdr-phone__text { text-decoration: underline; text-underline-offset: .2em; }
  .hdr-phone__icon { display: none; }
  .lang-switch { display: inline-flex; gap: var(--space-1); font-size: var(--fs-small); }
  .lang-switch__current { color: var(--color-text); font-weight: 600; }
  .lang-switch :global(.future-link) { min-width: 32px; min-height: 44px; justify-content: center; }
  .lang-switch { align-items: center; }
  .lang-switch :global(.future-link__note) { bottom: auto; top: calc(100% + .5rem); }
  .hdr-cta { min-height: 48px; font-size: 1.0625rem; padding-inline: var(--space-3); }
  .hdr-cta__short { display: none; }

  .menu-btn {
    display: none; align-items: center; justify-content: center; gap: var(--space-1);
    min-width: 44px; min-height: 44px; padding: 0 var(--space-1);
    border: 0; background: transparent; color: var(--color-text); cursor: pointer;
    font-family: var(--font-body); font-size: var(--fs-small);
  }
  .menu-btn__bars, .menu-btn__bars::before, .menu-btn__bars::after { display: block; width: 20px; height: 2px; background: currentColor; transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out); }
  .menu-btn__bars { position: relative; }
  .menu-btn__bars::before, .menu-btn__bars::after { content: ""; position: absolute; left: 0; }
  .menu-btn__bars::before { transform: translateY(-6px); }
  .menu-btn__bars::after { transform: translateY(6px); }
  .menu-btn[aria-expanded="true"] .menu-btn__bars { background: transparent; }
  .menu-btn[aria-expanded="true"] .menu-btn__bars::before { transform: rotate(45deg); background: var(--color-text); }
  .menu-btn[aria-expanded="true"] .menu-btn__bars::after { transform: rotate(-45deg); background: var(--color-text); }

  /* 1024–1279: tighter */
  @media (max-width: 1279px) {
    .site-nav__list { gap: var(--space-2); }
    .lang-switch { display: none; }
  }

  /* Below 1024: one bar — logo, phone icon, «Запит», menu */
  @media (max-width: 1023px) {
    .site-header__bar { gap: var(--space-1); flex-wrap: wrap; }
    .logo { margin-right: auto; }
    .logo__img { height: 30px; }
    .hdr-phone__icon { display: block; }
    .hdr-phone__text { display: none; }
    .hdr-cta { min-height: 44px; padding-inline: var(--space-2); font-size: 1rem; }
    .hdr-cta__long { display: none; }
    .hdr-cta__short { display: inline; }
    .site-header__actions { gap: var(--space-1); }

    /* without scripting: anchors as a wrapped second row */
    .site-nav { order: 3; flex-basis: 100%; margin: 0; padding-bottom: var(--space-1); }
    .site-nav__list { flex-wrap: wrap; column-gap: var(--space-3); row-gap: 0; }

    /* with scripting: a panel under the bar, opened by the menu button */
    :global(.js) .menu-btn { display: inline-flex; }
    :global(.js) .site-nav {
      position: absolute; left: 0; right: 0; top: 100%;
      max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
      padding: var(--space-3) var(--gutter) var(--space-4);
      background: var(--color-bg); border-bottom: var(--line) solid var(--color-border);
      display: none;
    }
    :global(.js) .site-header.is-open .site-nav { display: block; }
    :global(.js) .site-nav__list { flex-direction: column; gap: 0; }
    :global(.js) .site-nav__link { font-family: var(--font-display); font-stretch: var(--stretch-display); font-size: var(--fs-h3); font-weight: 600; min-height: 52px; }
    :global(.js) .site-nav__link::after { bottom: 10px; }
    :global(.js) .site-nav__extra { display: grid; gap: var(--space-3); margin-top: var(--space-3); padding-top: var(--space-3); border-top: var(--line) solid var(--color-border); }
    .site-nav__future { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: var(--fs-body); }
    .site-nav__future :global(.future-link) { min-height: 44px; }
    .site-nav__future :global(.future-link__note) { left: 0; transform: none; bottom: auto; top: 100%; }
    .site-nav__contacts { display: grid; gap: var(--space-1); justify-items: start; }
    .site-nav__phone { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.375rem; font-weight: 600; text-decoration: none; }
    .site-nav__role { font-family: var(--font-body); font-stretch: normal; font-size: var(--fs-small); font-weight: 400; color: var(--color-muted); margin-left: var(--space-1); }
    .site-nav__contacts .ulink { display: inline-flex; align-items: center; min-height: 44px; }
    .site-nav__hours { color: var(--color-muted); font-size: var(--fs-small); }
  }
  @media (max-width: 359px) {
    .menu-btn__label { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 4);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  if (header && btn) {
    btn.hidden = false;
    const set = (open: boolean) => {
      header.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    header.querySelectorAll<HTMLAnchorElement>(".site-nav a[href^='#']").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && header.classList.contains("is-open")) { set(false); btn.focus(); } });
  }
</script>
